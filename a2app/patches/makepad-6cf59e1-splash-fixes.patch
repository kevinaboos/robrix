+        });
+        set_ui_root(&mut cx, &pane);
+        let pane_uid = pane.widget_uid();
+
+        for run in 0..2 {
+            let host =
+                cx.with_vm(|vm| WidgetRef::script_from_value(vm, template.as_object().into()));
+            cx.widget_tree_insert_child_deep(pane_uid, live_id!(apphost), host.clone());
